TELEGRAM_BOT_TOKEN=paste_token_from_botfather_here

# Реальный Claude вместо заглушки (см. integrations/claude_real.py) —
# оставьте всё это пустым/не задавайте, чтобы продолжать работать на
# claude_mock.py. Заполните ОДИН из двух вариантов ниже, не оба:
#
# Вариант А — официальный console.anthropic.com:
#   Settings -> API keys -> Create Key, ключ выглядит как sk-ant-api03-...
ANTHROPIC_API_KEY=
#
# Вариант Б — сторонний прокси/реселлер (напр. если вам выдали доступ так):
#   такие сервисы обычно дают auth_token (Bearer), а не api_key (x-api-key) —
#   это РАЗНЫЕ переменные для Anthropic SDK, перепутать = 401 "invalid x-api-key"
#   даже с рабочим токеном. Обязательно нужен и свой ANTHROPIC_BASE_URL.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
#
# Необязательно — модель по умолчанию claude-sonnet-5, можно временно
# переключить на claude-haiku-4-5-20251001 для более дешёвого теста.
CLAUDE_MODEL=

# 24.07.2026 — база URL задеплоенной admin-panel (Vercel), нужна, чтобы
# вставлять ссылку на карточку эскалации прямо в текст пуша в Telegram
# (см. orchestrator._notify_escalation_recipients). Опционально — если не
# задать, пуш просто не будет содержать ссылку, ничего не сломается.
ADMIN_PANEL_BASE_URL=https://admin-panel-alpha-wheat-11.vercel.app

# 21.07.2026 — секрет для живой синхронизации промпта/фактов зелёной зоны
# из admin-panel (см. main.py, POST /admin/sync и logic/agent_prompt.py).
# Придумайте любую длинную случайную строку и вставьте ТУ ЖЕ САМУЮ в
# admin-panel (там она называется AGENT_BOT_SYNC_TOKEN, задаётся в Vercel
# Environment, не здесь). Если оставить пустым — /admin/sync отключён
# (503), остальной бот работает как раньше.
ADMIN_SYNC_TOKEN=

# 21.07.2026 — Supabase (минимальный срез, см. supabase_minimal_schema.sql
# в корне проекта). Оставьте пустым, чтобы продолжать работать на
# in-memory моке (integrations/db_mock.py) — ничего не сломается, просто
# staff_users/escalations не будут общими с admin-panel/облаком.
# ВАЖНО: здесь нужен SERVICE_ROLE ключ (полный доступ, не anon!) — берётся
# в Supabase -> Settings -> API -> Project API keys -> service_role.
# НЕ путать с NEXT_PUBLIC_SUPABASE_ANON_KEY в admin-panel (тот — для
# браузера, этот — только для доверенного бэкенда).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 22.07.2026 — доступ на чтение к боевому Google Sheet (Франсуа выдал
# доступ сервисному аккаунту к таблице "июнь"). Используется
# sheets_read_check.py (разовая проверка) и integrations/google_sheets_client.py
# (реальный импорт "Заказы на день" -> sheet_import_log, см. /admin/import-sheet
# и /cron/sheets-import-check в main.py). GOOGLE_SHEET_ID/GID берутся из URL
# таблицы: .../spreadsheets/d/ЭТО_ID/edit?gid=ЭТО_GID
#
# Ключ сервисного аккаунта — ЛИБО путь к файлу (локально), ЛИБО весь JSON
# текстом прямо в переменной (на Render, где нет файловой системы для
# секретов) — заполните ОДИН из двух вариантов:
GOOGLE_SERVICE_ACCOUNT_JSON=google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=
# 22.07.2026 — gid вкладки "1. Клиенты" (см. sheets_read_check.py, тот же
# файл, другая вкладка) — сырой снимок в sheet_clients_snapshot_log, см.
# /admin/import-clients-sheet.
GOOGLE_SHEET_CLIENTS_GID=

# 24.07.2026 — ЗАПИСЬ агента в Google Sheet (уровень 5, tool-use — ЕЩЁ НЕ
# РЕАЛИЗОВАНО, только зарезервировано место под конфигурацию). Решение
# Игоря: писать нужно туда же, куда будет нужно на проде (в перспективе —
# в ТУ ЖЕ таблицу, что и GOOGLE_SHEET_ID/GID выше, т.к. на проде Ольга и
# бот какое-то время редактируют одну и ту же живую таблицу), но сейчас,
# для безопасного теста — в отдельную таблицу-песочницу (создана Игорем
# 24.07.2026, сервисному аккаунту дан доступ Editor):
# https://docs.google.com/spreadsheets/d/1UtkSiYGjp6QnIvVC-GSmz5ZFUwWZIUS8O4EvKjMc8Hw/edit?gid=645774820
# Отдельные переменные (не переиспользуем GOOGLE_SHEET_ID/GID выше) —
# чтобы случайно не начать писать в боевую таблицу до того, как Игорь
# явно переключит на прод, просто поменяв значения этих двух переменных
# (код менять не придётся).
# ВАЖНО (найдено 24.07.2026 через sheets_write_check.py): песочница — это
# копия боевой таблицы, gid'ы вкладок в ней СОХРАНИЛИСЬ как в оригинале —
# 645774820 там оказалась вкладкой "1. Клиенты", а не "2. Заказы на день"!
# Правильный gid вкладки "Заказы на день" в песочнице — 852716824 (тот же,
# что и на проде).
GOOGLE_SHEET_WRITE_ID=1UtkSiYGjp6QnIvVC-GSmz5ZFUwWZIUS8O4EvKjMc8Hw
GOOGLE_SHEET_WRITE_GID=852716824
